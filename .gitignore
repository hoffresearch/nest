/target
# Cargo.lock IS tracked: urna ships a CLI binary, so a committed lockfile is
# required for reproducible builds and CVE triage against a pinned dep set.
**/*.rs.bk
*.pdb
*.so
*.dylib
*.dll
# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
wheels/
.pytest_cache/
.mypy_cache/
.ropeproject/
.ruff_cache/
.python-version

# Virtual environments
.venv
venv/
env/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Project specific
# data/corpus_next.v1.urna remains tracked via Git LFS.
# Per-phase preset .urna files (data/measure/corpus_*.urna) are
# regeneration artifacts: re-derivable in minutes by measure_presets.py
# from the LFS-tracked baseline. Do NOT commit them: they'd inflate the
# LFS bandwidth quota every phase. We commit only the JSON checksums and
# metrics next to them.
data/measure/corpus_*.urna
data/measure/*.urna-*


# Temporary workspace for agent sessions.
tmp/

# Local symlink to external hoff database (not part of this repo)
data/hoff.db

# PHI / clinical artifacts: NEVER commit. clinical data lives OUTSIDE this repo
# (e.g. /Volumes/<redacted>/dat/psy/work, which is NOT under any git repo). these
# patterns are defense-in-depth so a misdirected --out into the repo tree can
# never be staged or pushed by any auto-committer, INCLUDING a `git add -A`
# from a `--no-verify` commit, which still honors .gitignore.
#
# Ignore ALL .urna by default (a PHI export with any name, not just cohort_*),
# then negate ONLY the two sanctioned PUBLIC, non-PHI files that ARE tracked.
*.urna
*.sidecar.jsonl
**/pairs/
!data/corpus_next.v1.urna
!crates/format/tests/fixtures/golden_v1_minimal.urna

# demo datasets are local-only (data/demo/Instructions.md says how to fetch them).
data/demo/*
!data/demo/Instructions.md
.env

# wheel staging (script/wheelprep.py output)
packs/staging/
# mtg corpus artifacts (the benchmark lives in its own repository)
data/mtg/

# cargo-fuzz working state (seeds/ stays tracked)
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
fuzz/coverage/

# competitor benchmark scratch stores (python/tools/bench_competitors.py --work)
.bench-competitors/
/tools/

# local-only planning notes, never published
docs/hardening-plan.md
TMP/

# quickstart build output (demos/quickstart/corpus.toml)
demos/quickstart/out/
