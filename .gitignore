# dat/corpus_next.v1.nest remains tracked via Git LFS.
# Per-phase preset .nest files (dat/measure/corpus_*.nest) are
# regeneration artifacts: re-derivable in minutes by measure_presets.py
# from the LFS-tracked baseline. Do NOT commit them — they'd inflate the
# LFS bandwidth quota every phase. We commit only the JSON checksums and
# metrics next to them.
dat/measure/corpus_*.nest
dat/measure/*.nest-*


# Local symlink to external hoff database (not part of this repo)
dat/hoff.db

# PHI / clinical artifacts — NEVER commit. clinical data lives OUTSIDE this repo
# (e.g. /Volumes/<redacted>/dat/psy/work). these patterns are defense-in-depth so a
# misdirected --out into the repo tree can never be staged or pushed by any
# auto-committer. the demo corpus_*.nest above are non-PHI and handled separately.
*.sidecar.jsonl
cohort_*.nest
**/pairs/

